# ============================================================
# SES Core — Environment Configuration
# ============================================================
# Copy this file to `.env` and fill in real values.
# Lines starting with # are comments. Uncomment to override.
# ses serve does not load .env automatically. For Bash, from the repo root:
#   set -a; . ./.env; set +a; ses serve
# Source only a trusted file; quote values containing spaces.
# Docker Compose interpolates only variables declared in docker-compose.yml.
# ============================================================

# --- General ---
# Set to "true" only during local development.
# In production this MUST be "false" to enforce fail-closed security.
DEBUG=false

# --- Operational Modes ---
# 1. Local Embedded RAG (default)
# 2. Hosted Curated Tollgate (requires Qdrant + Payment Setup)
# 3. Future Private / Marketplace (not part of current build)
EMBEDDED_MODE=true
SES_DATA_DIR=./ses_data

# --- Embedding Model ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
# VECTOR_SIZE is fixed at 384 for the default model

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Qdrant (Vector Store) ---
QDRANT_URL=http://localhost:6333
# Required for remote/managed Qdrant in production. Local Docker Qdrant may omit it.
# QDRANT_API_KEY=change_me

# --- Redis (Rate Limiting & Usage Tracking) ---
REDIS_HOST=localhost
REDIS_PORT=6379
# Required for remote/managed Redis in production. Local Docker Redis may omit it.
# REDIS_PASSWORD=change_me

# --- Payment Config ---
# MODO: simulated, solana-devnet, solana-mainnet.
# simulated is only for local development and automated tests.
SES_PAYMENT_MODE=simulated

# Solana Pay (USDC tollgate) — real payments when DEBUG=false
# Choose the network. USDC_MINT defaults correctly per network if omitted.
# SOLANA_NETWORK=devnet
# SOLANA_RPC_URL=https://api.devnet.solana.com
# USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# SOLANA_MERCHANT_SECRET= (base58 secret key for the receiving wallet)
# For mainnet-beta use the official Circle/USDC mint and mainnet RPC.
# Do not commit .env, merchant.env, wallet secrets, private keys, or Compose config output containing secrets.

# --- LLM / RAG ---
# Primary provider for answer generation (Local 100% Offline)
OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=60
# If Ollama is unavailable, the local gateway returns a fallback answer over retrieved citations.
# Treat that as development behavior, not verified production answer quality.

# --- CORS (API) ---
# Comma-separated list. Leave empty to use safe defaults (restricted except DEBUG).
# CORS_ALLOW_ORIGINS=https://your-frontend.example.com,https://agent.example.com

# --- Namespace Quotas (Fase 1) ---
MAX_DOCS_PER_NAMESPACE=10000
MAX_CHUNKS_PER_NAMESPACE=50000
